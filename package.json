{
    "name": "@mat3ra/move",
    "version": "0.0.0",
    "description": "Model/Method Viewer and Editor",
    "repository": {
        "type": "git",
        "url": "https://github.com/mat3ra/move.git"
    },
    "bugs": {
        "url": "https://github.com/mat3ra/move/issues"
    },
    "homepage": "https://github.com/mat3ra/move",
    "main": "dist/exports.js",
    "types": "dist/exports.d.ts",
    "exports": {
        ".": {
            "types": "./dist/exports.d.ts",
            "import": "./dist/exports.js",
            "default": "./dist/exports.js"
        },
        "./pseudo": {
            "types": "./dist/pseudo.d.ts",
            "import": "./dist/pseudo.js",
            "default": "./dist/pseudo.js"
        }
    },
    "files": [
        "/dist",
        "/src",
        "tsconfig.json"
    ],
    "scripts": {
        "dev": "vite --port 3005",
        "build": "tsc && npm run copy-css",
        "build:standalone": "vite build",
        "copy-css": "mkdir -p dist/stylesheets && cp src/stylesheets/* dist/stylesheets/ 2>/dev/null || true",
        "transpile": "tsc",
        "test": "node --import tsx --test tests/*.tests.ts",
        "lint": "eslint src tests && prettier --check src tests",
        "prepublishOnly": "npm run transpile"
    },
    "dependencies": {
        "@mat3ra/mode": "*",
        "@mat3ra/standata": "*"
    },
    "peerDependencies": {
        "@mat3ra/code": "*",
        "@mat3ra/esse": "*",
        "@mat3ra/prode": "*",
        "@mat3ra/wode": "*",
        "react": "^17.0.0",
        "react-dom": "^17.0.0",
        "simpl-schema": "git+https://github.com/Exabyte-io/simpl-schema.git#355fbea163da5be1946dc66c7ed951f53878d15c"
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "tsx": "^4.22.4",
        "typescript": "^5.6.6",
        "@mat3ra/tsconfig": "^2024.6.3-0",
        "@types/react": "^17.0.2",
        "@types/react-dom": "^17.0.2",
        "@types/node": "^20.11.30",
        "vite": "^6.0.7",
        "@vitejs/plugin-react": "^4.3.4",
        "vite-plugin-node-polyfills": "^0.25.0",
        "@mui/material": "^5.11.9",
        "@mui/lab": "^5.0.0-alpha.120",
        "@mui/icons-material": "^5.11.9",
        "lodash": "^4.17.4",
        "underscore": "^1.8.3",
        "underscore.string": "^3.3.4",
        "mathjs": "^3.9.0",
        "@rjsf/utils": "^5.1.0",
        "@rjsf/mui": "^5.1.0",
        "@rjsf/validator-ajv8": "^5.1.0",
        "@mat3ra/cove": "https://github.com/mat3ra/cove/releases/download/wip-3374a52/cove.tgz",
        "@mat3ra/wave.js": "https://github.com/mat3ra/wave.js/releases/download/wip-1bd0a38/wave.js.tgz",
        "@emotion/babel-plugin": "^11.11.0",
        "@emotion/react": "^11.11.0",
        "@emotion/styled": "^11.11.0",
        "@mat3ra/esse": "https://github.com/mat3ra/esse/releases/download/wip-b8494e3c7/esse.tgz",
        "@mat3ra/ade": "https://github.com/mat3ra/ade/releases/download/wip-3b07db5/ade.tgz",
        "@mat3ra/code": "https://github.com/mat3ra/code/releases/download/wip-c893e27/code.tgz",
        "@mat3ra/ide": "https://github.com/mat3ra/ide/releases/download/wip-88b8881/ide.tgz",
        "@mat3ra/made": "https://github.com/mat3ra/made/releases/download/wip-b5ab8c9/made.tgz",
        "@mat3ra/mode": "https://github.com/mat3ra/mode/releases/download/wip-f8543e7/mode.tgz",
        "@mat3ra/prode": "https://github.com/mat3ra/prode/releases/download/wip-1d8901b/prode.tgz",
        "@mat3ra/wode": "https://github.com/mat3ra/wode/releases/download/wip-d020bc9/wode.tgz",
        "@mat3ra/standata": "https://github.com/mat3ra/standata/releases/download/wip-c5ba9be/standata.tgz",
        "@mui/styles": "^5.11.9",
        "react": "^17.0.0",
        "react-dom": "^17.0.0",
        "reactflow": "^11.7.2",
        "simpl-schema": "git+https://github.com/Exabyte-io/simpl-schema.git#355fbea163da5be1946dc66c7ed951f53878d15c",
        "@types/lodash": "^4.14.202"
    }
}
